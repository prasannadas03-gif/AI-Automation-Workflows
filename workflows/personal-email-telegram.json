      "parameters": {
        "jsCode": "\nconst cbq = $input.first().json.callback_query;\nif (!cbq) return [];\nconst callbackId = cbq.id;\nconst chatId = String(cbq.message?.chat?.id || '');\nconst messageId = cbq.message?.message_id ? String(cbq.message.message_id) : '';\nconst data = cbq.data || '';\nconst parts = data.split(':');\nconst action = parts[0];\nconst rowId = Number(parts[1]) || parts[1];\n\nreturn [{ json: { action, rowId, callbackId, chatId, messageId } }];\n"
