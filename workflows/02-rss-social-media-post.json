{
  "name": "RSS Feed → Social Media Pipeline",
  "description": "Monitors the RINDAX blog RSS feed and auto-publishes new articles to LinkedIn, Facebook, and Instagram with Claude AI-generated captions. Zero manual input required.",
  "nodes": [
    {
      "name": "RSS Feed Trigger",
      "type": "n8n-nodes-base.rssFeedReadTrigger",
      "notes": "Polls blog RSS feed at 9:30 AM and 6 PM. Fires only when a new article is detected.",
      "parameters": {
        "pollTimes": {"item": [{"hour": 9, "minute": 30}, {"hour": 18}]},
        "feedUrl": "YOUR_BLOG_RSS_FEED_URL"
      }
    },
    {
      "name": "HTML Parser — Extract Featured Image",
      "type": "n8n-nodes-base.html",
      "notes": "Extracts featured image URL from blog post HTML content",
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "content:encoded",
        "extractionValues": {
          "values": [{
            "key": "extracted_image",
            "cssSelector": "img",
            "returnValue": "attribute",
            "attribute": "src"
          }]
        }
      }
    },
    {
      "name": "Claude AI — Generate Captions",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "notes": "Claude Sonnet generates unique captions for each platform based on article title and content",
      "parameters": {
        "promptType": "define",
        "text": "Generate unique social media captions for LinkedIn, Facebook, and Instagram based on the blog post. Return JSON with keys: linkedin_post, facebook_post, instagram_caption."
      }
    },
    {
      "name": "OpenRouter Chat Model (Claude Sonnet)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "parameters": {
        "model": "anthropic/claude-sonnet-4-6",
        "options": {"maxTokens": 1200},
        "credentials": "YOUR_OPENROUTER_API_KEY"
      }
    },
    {
      "name": "Facebook Post",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/YOUR_FACEBOOK_PAGE_ID/photos",
        "bodyParameters": {
          "parameters": [
            {"name": "message", "value": "={{ JSON.parse($json.text).facebook_post }}"},
            {"name": "url", "value": "={{ $('HTML Parser — Extract Featured Image').item.json.extracted_image }}"},
            {"name": "access_token", "value": "YOUR_FACEBOOK_PAGE_ACCESS_TOKEN"}
          ]
        }
      }
    },
    {
      "name": "Facebook Comment (Blog Link)",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/YOUR_FACEBOOK_POST_ID/comments",
        "bodyParameters": {
          "parameters": [
            {"name": "message", "value": "Read the full article 👇\n={{ $('RSS Feed Trigger').item.json.link }}"},
            {"name": "access_token", "value": "YOUR_FACEBOOK_PAGE_ACCESS_TOKEN"}
          ]
        }
      }
    },
    {
      "name": "Download Blog Image for LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{ $('HTML Parser — Extract Featured Image').item.json.extracted_image }}",
        "options": {"response": {"response": {"responseFormat": "file"}}}
      }
    },
    {
      "name": "LinkedIn Post",
      "type": "n8n-nodes-base.linkedIn",
      "parameters": {
        "person": "YOUR_LINKEDIN_PERSON_ID",
        "text": "={{ JSON.parse($json.text).linkedin_post }}",
        "shareMediaCategory": "IMAGE",
        "credentials": "YOUR_LINKEDIN_OAUTH_CREDENTIALS"
      }
    },
    {
      "name": "Instagram — Create Media Container",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/YOUR_INSTAGRAM_ACCOUNT_ID/media",
        "bodyParameters": {
          "parameters": [
            {"name": "caption", "value": "={{ JSON.parse($json.text).instagram_caption }}"},
            {"name": "image_url", "value": "={{ $('HTML Parser — Extract Featured Image').item.json.extracted_image }}"},
            {"name": "access_token", "value": "YOUR_INSTAGRAM_ACCESS_TOKEN"}
          ]
        }
      }
    },
    {
      "name": "Instagram — Publish",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/YOUR_INSTAGRAM_ACCOUNT_ID/media_publish",
        "queryParameters": {
          "parameters": [
            {"name": "creation_id", "value": "={{ $json.id }}"},
            {"name": "access_token", "value": "YOUR_INSTAGRAM_ACCESS_TOKEN"}
          ]
        }
      }
    },
    {
      "name": "Instagram Comment (Blog Link)",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/YOUR_INSTAGRAM_POST_ID/comments",
        "bodyParameters": {
          "parameters": [
            {"name": "message", "value": "={{ $('RSS Feed Trigger').item.json.link }}"},
            {"name": "access_token", "value": "YOUR_INSTAGRAM_ACCESS_TOKEN"}
          ]
        }
      }
    }
  ],
  "connections": {
    "RSS Feed Trigger": {"main": [[{"node": "HTML Parser — Extract Featured Image"}]]},
    "HTML Parser — Extract Featured Image": {"main": [[{"node": "Claude AI — Generate Captions"}]]},
    "Claude AI — Generate Captions": {"main": [[{"node": "Facebook Post"}, {"node": "Download Blog Image for LinkedIn"}, {"node": "Instagram — Create Media Container"}]]},
    "Facebook Post": {"main": [[{"node": "Facebook Comment (Blog Link)"}]]},
    "Download Blog Image for LinkedIn": {"main": [[{"node": "LinkedIn Post"}]]},
    "Instagram — Create Media Container": {"main": [[{"node": "Instagram — Publish"}]]},
    "Instagram — Publish": {"main": [[{"node": "Instagram Comment (Blog Link)"}]]}
  },
  "meta": {
    "built_by": "Prasanna Kumar Das | RINDAX",
    "website": "https://rindax.com",
    "tools_used": ["n8n", "Claude AI", "OpenRouter", "RSS Feed", "LinkedIn API", "Facebook Graph API", "Instagram Graph API"]
  }
}
