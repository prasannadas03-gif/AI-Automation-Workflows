        "jsCode": "// Get lead base data — handle both flat and nested fields structure\nconst fields = $input.item.json.fields || $input.item.json;\nconst lead = $input.item.json;\n\n// Website content from Scrape Website node\nlet websiteText = 'No website available';\ntry {\n  const websiteRaw = $('Scrape Website').item?.json?.data || $('Scrape Website').item?.json?.body || '';\n  if (typeof websiteRaw === 'string' && websiteRaw.length > 0) {\n    websiteText = websiteRaw.replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim().substring(0, 2000);\n  }\n} catch(e) { websiteText = 'Website scrape failed'; }\n\n// Google Search results\nlet searchSnippets = 'No search results';\ntry {\n  const searchResults = $('Google Search Lead').item?.json?.organic_results || [];\n  if (searchResults.length > 0) {\n    searchSnippets = searchResults.slice(0, 3).map(r => r.snippet || '').filter(Boolean).join(' | ');\n  }\n} catch(e) { searchSnippets = 'Search failed'; }\n\n// Google Maps data\nlet mapsInfo = 'No Maps data';\nlet mapsReviews = 'No reviews found';\ntry {\n  const mapsResults = $('Google Maps Lead').item?.json?.local_results || [];\n  if (mapsResults.length > 0) {\n    const mapsData = mapsResults[0];\n    mapsInfo = `Rating: ${mapsData.rating || 'N/A'}, Reviews: ${mapsData.reviews || 'N/A'}, Category: ${mapsData.type || 'N/A'}, Address: ${mapsData.address || 'N/A'}`;\n    const reviewSnippets = (mapsData.reviews_from_snippet || []).slice(0, 3).map(r => r.snippet || '').filter(Boolean);\n    if (reviewSnippets.length > 0) mapsReviews = reviewSnippets.join(' | ');\n  }\n} catch(e) { mapsInfo = 'Maps search failed'; }\n\nreturn {\n  json: {\n    ...lead,\n    'Website URL': fields['Website URL'] || '',\n    research: {\n      websiteContent: websiteText,\n      googleSearch: searchSnippets,\n      googleMaps: mapsInfo,\n      customerReviews: mapsReviews\n    }\n  }\n};"
