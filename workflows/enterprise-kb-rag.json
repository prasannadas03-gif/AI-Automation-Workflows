    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nreturn items.map(item => {\n  const b = item.json.body || item.json;\n  const raw = String(b.text || '');\n  const cleanText = raw.replace(/\\r\\n/g, '\\n').replace(/[ \\t]+/g, ' ').replace(/\\n{3,}/g, '\\n\\n').trim();\n  return {\n    json: {\n      document_name: b.document_name || 'Untitled Document',\n      document_type: b.document_type || 'General',\n      category: b.category || 'Uncategorized',\n      product: b.product || 'N/A',\n      version: b.version || '1.0',\n      source: b.source || 'manual_upload',\n      client_id: b.client_id || 'default_client',\n      cleanText\n    }\n  };\n});\n"
      },
      "name": "Clean & Normalize Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*)::int as cnt FROM documents WHERE metadata->>'document_name' = $1 AND metadata->>'version' = $2 AND metadata->>'client_id' = $3",
        "options": {
          "queryReplacement": "={{ $json.document_name }},{{ $json.version }},{{ $json.client_id }}"
        }
      },
