    {
      "parameters": {},
      "name": "Gemini Embeddings (Query TG)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        80,
        1152
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const docs = $input.all();\nconst minDocs = 1;\nconst minTotalChars = 80;\nlet context = '';\nconst sources = [];\nfor (const d of docs) {\n  const doc = d.json.document || d.json;\n  const text = doc.pageContent || doc.text || '';\n  context += text + '\\n\\n';\n  const meta = doc.metadata || {};\n  if (meta.document_name) sources.push(meta.document_name);\n}\nconst sufficient = docs.length >= minDocs && context.trim().length >= minTotalChars;\nreturn [{\n  json: {\n    question: $('Normalize Telegram Question').item.json.question,\n    sessionId: $('Normalize Telegram Question').item.json.sessionId,\n    chatId: $('Normalize Telegram Question').item.json.chatId,\n    context: context.trim(),\n    sources: [...new Set(sources)],\n    sufficient\n  }\n}];"
      },
      "name": "Assess Retrieval Sufficiency (TG)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        928
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.sufficient }}",
              "operator": {
                "operation": "true",
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          }
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "name": "Sufficient Context? (TG)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        576,
        928
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.question }}",
        "options": {
          "systemMessage": "=You are a company knowledge-base support assistant answering inside a Telegram chat. Answer the user's question using ONLY the context below. Do not use outside knowledge and never invent details. If the context does not contain the answer, say clearly that the information is not available in the knowledge base and offer to connect the user with a human team member.\n\nWrite your reply as PLAIN TEXT ONLY, suitable for a Telegram message. Do NOT use markdown formatting: no **bold**, no bullet points with * or -, no backtick code blocks, no headers. Use plain sentences and, if listing items, use simple numbered lines like \"1. ...\" instead.\n\nContext:\n{{ $json.context }}"
        }
      },
      "name": "Grounded Answer Agent (TG)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        800,
        672
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {
          "temperature": 0.2
        }
      },
      "name": "Gemini Answer Model (TG)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        816,
        896
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.sessionId }}",
        "contextWindowLength": 6
      },
      "name": "Session Memory (TG)",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        944,
        896
      ],
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const out = $input.first().json;\nconst upstream = $('Assess Retrieval Sufficiency (TG)').first().json;\nconst answer = out.output || String(out);\nreturn [{ json: { chatId: upstream.chatId, text: answer } }];"
      },
      "name": "Format Telegram Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        768
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
