    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const msg = item.json.message || {};\n  const chatId = msg.chat && msg.chat.id;\n  return {\n    json: {\n      question: String(msg.text || '').trim(),\n      chatId: chatId,\n      sessionId: 'telegram_' + chatId,\n      clientId: 'default_client'\n    }\n  };\n});"
      },
      "name": "Normalize Telegram Question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        928
      ]
    },
    {
      "parameters": {
        "mode": "load",
        "tableName": {
          "__rl": true,
          "mode": "id",
          "value": "documents"
        },
        "prompt": "={{ $json.question }}",
        "topK": 5,
        "options": {
          "queryName": "match_documents",
          "metadata": {
            "metadataValues": [
              {
                "name": "client_id",
                "value": "={{ $json.clientId }}"
              }
            ]
          }
        }
      },
      "name": "Retrieve Top-K Chunks (TG)",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [
        0,
        928
      ],
      "credentials": {
        "supabaseApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Supabase account"
        }
