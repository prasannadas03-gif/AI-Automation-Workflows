    },
    {
      "parameters": {
        "jsCode": "const upstream = $('Assess Retrieval Sufficiency (TG)').first().json;\nreturn [{\n  json: {\n    chatId: upstream.chatId,\n    text: \"I don't have that information in the knowledge base yet - I'll connect you with a team member who can help.\"\n  }\n}];"
      },
